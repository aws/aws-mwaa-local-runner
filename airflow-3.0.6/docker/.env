# AWS MWAA Local Runner 3.0.6 - Environment Variables
# 
# This file is the equivalent of 'mwaa-local-env' from MWAA 2.10.3
# 
# Copy this file to '.env' in the docker/ directory and set your values:
#   cp .env.example .env
#   # Then edit .env with your actual values
#
# Docker Compose automatically reads .env files from the same directory
# where docker-compose.yml is located.

# ============================================================================
# AWS Credentials
# ============================================================================
# Set these to your AWS credentials (or use AWS CLI profile)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_SESSION_TOKEN=  # Optional: for temporary credentials
AWS_REGION=us-west-2
AWS_DEFAULT_REGION=us-west-2

# ============================================================================
# MWAA Configuration
# ============================================================================
# Path to requirements.txt (default is fine for most cases)
MWAA__CORE__REQUIREMENTS_PATH=/usr/local/airflow/requirements/requirements.txt

# Startup script path (optional)
MWAA__CORE__STARTUP_SCRIPT_PATH=

# KMS Key ARN (optional, for production-like testing)
MWAA__CORE__KMS_KEY_ARN=

# ============================================================================
# Snowflake Configuration
# ============================================================================
# Set these to your Snowflake connection details (if needed)
SNOWFLAKE_ACCOUNT=your-snowflake-account
SNOWFLAKE_USER=your-snowflake-user
SNOWFLAKE_ROLE=your-snowflake-role
SNOWFLAKE_WAREHOUSE=your-snowflake-warehouse
SNOWFLAKE_DATABASE=your-snowflake-database
SNOWFLAKE_SCHEMA=your-snowflake-schema

# Path to Snowflake private key (inside container)
# The key file should be placed in ../secrets/snowflake_key.p8
SNOWFLAKE_PRIVATE_KEY_PATH=/usr/local/airflow/secrets/snowflake_key.p8

# ============================================================================
# Notes
# ============================================================================
# - All variables with ${VARIABLE_NAME} syntax in docker-compose-local.yml
#   will be read from this .env file or your shell environment
# - Variables with default values (e.g., ${VAR:-default}) will use the default
#   if not set in .env or environment
# - Docker Compose reads .env automatically - no need to source it manually
# - For security, add .env to .gitignore (don't commit secrets)
# - Leave values empty if not needed (they'll use defaults from docker-compose)
